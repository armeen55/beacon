      "src/domains/proof-gsc/kernel.ts": 773,
      "src/lib/persistence/repositories/supabase-backend.ts": 746,
      "src/domains/evidence/snapshot.ts": 721,
      "src/lib/connectors/gsc/sync-search-analytics.ts": 708,
      "src/domains/drafts/source-authority.ts": 694,
      "src/domains/pages/extractor.ts": 668,
