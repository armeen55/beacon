{
  "_doc": "Bloat firewall. Ceilings are NON-INCREASING: ratchet DOWN as code shrinks, never up without operator approval. Enforced by scripts/check-foundation-budget.mjs (npm run guard:foundation). Foundation is frozen; see AGENTS.md for the growth policy and the 8-field feature rule.",
  "production": {
    "max": 71000,
    "target": 55000
  },
  "tests": {
    "max": 4750,
    "target": 4000
  },
  "combined": {
    "hardCap": 100000,
    "target": 60000
  },
  "domains": {
    "max": 5,
    "target": 5,
    "_note": "The five kernels: account, evidence, decision, measurement, runtime. No new top-level domain without operator approval."
  },
  "routes": {
    "pagesAllow": [
      "/",
      "(shell)",
      "(shell)/today",
      "(shell)/changes",
      "(shell)/changes/[id]",
      "(shell)/results",
      "(shell)/connections",
      "(shell)/settings",
      "(shell)/settings/config",
      "(shell)/settings/connectors",
      "(shell)/onboard",
      "(shell)/onboard/done",
      "login",
      "(public)/signup"
    ],
    "apiAllow": [
      "api/version",
      "api/connectors/google/callback"
    ]
  },
  "files": {
    "newFileMax": 500,
    "hardMax": 800,
    "_note": "NEW production file may not exceed newFileMax. Grandfathered files below carry a non-increasing ceiling = current size; shrink them, never grow. Clearing a file (trim under newFileMax) is encouraged.",
    "grandfathered": {
      "src/domains/decision/llm/structured-drafter.ts": 1628,
      "src/app/(shell)/settings/connectors/connectors-client.tsx": 1377,
      "src/lib/connectors/ga4/data-api.ts": 1376,
      "src/app/(shell)/settings/connectors/actions.ts": 1237,
      "src/lib/connector-store.ts": 1166,
      "src/domains/decision/drafts/draft-quality.ts": 983,
      "src/lib/persistence/dual-write.ts": 905,
            "src/domains/measurement/attribution/url-change-outcome.ts": 820,
      "src/domains/measurement/attribution/url-verdict.ts": 772,
      "src/domains/measurement/proof-gsc/kernel.ts": 768,
      "src/lib/persistence/repositories/supabase-backend.ts": 741,
      "src/domains/evidence/snapshot.ts": 716,
      "src/lib/connectors/gsc/sync-search-analytics.ts": 703,
      "src/domains/decision/drafts/source-authority.ts": 689,
      "src/domains/evidence/readers/dataforseo-serp.ts": 663,
      "src/domains/evidence/pages/extractor.ts": 663,
      "src/domains/evidence/pages/types.ts": 651,
      "src/domains/evidence/scanning/crawl-frontier.ts": 640,
      "src/lib/net/safe-source-fetch.ts": 611,
      "src/domains/decision/llm/schemas.ts": 607,
      "src/lib/connectors/google-auth.ts": 590,
      "src/domains/evidence/product/url-citation-history.ts": 568,
      "src/domains/evidence/pages/extractors/extractors.ts": 566,
      "src/domains/evidence/readers/gsc-page-signals.ts": 555,
      "src/domains/decision/changes/recommended-edits-persistence.ts": 548,
      "src/lib/persistence/store-classification.ts": 526,
      "src/lib/connectors/wix/client.ts": 507
    }
  },
  "imports": {
    "_note": "src/app + src/components consume the 5 kernels through their public facade (index.ts) only. Deep VALUE imports of kernel internals are forbidden; import type deep-imports are allowed (erased at compile).",
    "appForbiddenDomainDeep": [
      "@/domains/account/",
      "@/domains/evidence/",
      "@/domains/decision/",
      "@/domains/measurement/",
      "@/domains/runtime/"
    ],
    "_directionNote": "Dependency direction: Account -> Evidence -> Decision -> Measurement; Runtime orchestrates. Forbidden: Evidence importing Decision/Measurement; Measurement importing Decision. Known pre-existing leaks are grandfathered below (non-increasing) and tracked for severance; no NEW leak may be added.",
    "kernelForbiddenEdges": {
      "evidence": [
        "decision",
        "measurement"
      ],
      "measurement": [
        "decision"
      ]
    },
    "kernelDirectionExceptions": [
      "src/domains/evidence/product/url-watcher.ts->measurement",
      "src/domains/evidence/readers/gsc-page-signals.ts->measurement",
      "src/domains/measurement/proof-gsc/auto-measure-on-use.ts->decision",
      "src/domains/measurement/proof-gsc/measure-pass.ts->decision",
      "src/domains/measurement/proof-gsc/verdict-schedule.ts->decision",
      "src/domains/measurement/scoreboard/scoreboard.ts->decision"
    ]
  },
  "exports": {
    "max": 1936,
    "target": 1200,
    "_note": "Exported type/interface/class/enum/const/function symbols in src (non-test). Non-increasing; keep internal helpers/types internal. Ratchet DOWN."
  },
  "markdown": {
    "_note": "Documentation budget. Git history is the archive. No docs/archive/. No new AUDIT/REPORT/WIP/HISTORY/ROADMAP/dated-plan docs without operator approval.",
    "maxFiles": 4,
    "maxTotalLines": 1000,
    "forbidArchive": true,
    "forbiddenNamePattern": "(AUDIT|REPORT|_WIP|WIP_|HISTORY|ROADMAP|NIGHT_SHIFT|AUTONOMOUS_PROGRESS)",
    "allowlist": [
      "AGENTS.md",
      "CLAUDE.md",
      "docs/HANDOFF_VERIFIED_STATE.md",
      "docs/PRODUCT_TRUTH.md"
    ],
    "perFileCeilings": {
      "AGENTS.md": 200,
      "CLAUDE.md": 45,
      "docs/HANDOFF_VERIFIED_STATE.md": 200,
      "docs/PRODUCT_TRUTH.md": 600
    }
  },
  "deps": {
    "_note": "Runtime dependencies. Adding one requires explicit operator approval.",
    "allow": [
      "@base-ui/react",
      "@supabase/ssr",
      "@supabase/supabase-js",
      "cheerio",
      "class-variance-authority",
      "clsx",
      "geist",
      "lucide-react",
      "next",
      "puppeteer-core",
      "react",
      "react-dom",
      "server-only",
      "shadcn",
      "tailwind-merge",
      "tw-animate-css",
      "zod"
    ]
  }
}
