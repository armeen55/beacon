{
  "_doc": "The bloat firewall. Ceilings are NON-INCREASING: ratchet them DOWN as code shrinks, never up without explicit operator approval. Enforced by scripts/check-foundation-budget.mjs (npm run guard:foundation). Targets: production <=55000, tests <=18000, combined <=75000, absolute MVP hard cap 100000. Ordinary feature task: <=750 net new lines; >750 needs operator approval; >2000 must decompose or replace existing code; a replacement deletes the old path in the same phase; no new top-level domain / customer route / dependency without explicit approval.",
  "production": {
    "max": 71000,
    "target": 55000
  },
  "tests": {
    "max": 6000,
    "target": 18000
  },
  "combined": {
    "hardCap": 100000,
    "target": 75000
  },
  "domains": {
    "max": 34,
    "target": 10,
    "_note": "ratchet down as legacy domains are internalized behind the five kernel facades"
  },
  "routes": {
    "pagesAllow": [
      "/",
      "(shell)",
      "(shell)/today",
      "(shell)/changes",
      "(shell)/changes/[id]",
      "(shell)/results",
      "(shell)/connections",
      "(shell)/settings",
      "(shell)/settings/config",
      "(shell)/settings/connectors",
      "(shell)/onboard",
      "(shell)/onboard/done",
      "login",
      "(public)/signup"
    ],
    "apiAllow": [
      "api/version",
      "api/connectors/google/callback"
    ]
  },
  "files": {
    "newFileMax": 500,
    "hardMax": 800,
    "_note": "A NEW production file may not exceed newFileMax. Grandfathered oversized files below have a non-increasing ceiling = their current size; shrink them, never grow them. Clearing a file from this list (by trimming under newFileMax) is encouraged.",
    "grandfathered": {
      "src/domains/llm/structured-drafter.ts": 1633,
      "src/app/(shell)/settings/connectors/connectors-client.tsx": 1382,
      "src/lib/connectors/ga4/data-api.ts": 1381,
