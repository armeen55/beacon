# Beacon v1 environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.

# ---------------------------------------------------------------------------
# Tenant context (CX1)
# ---------------------------------------------------------------------------
# Which tenant this instance serves. v1 dev uses env-var switching.
# CX7 replaces with Clerk session-based tenant resolution.
BEACON_TENANT_ID=tenant-ritz-founder

# ---------------------------------------------------------------------------
# Data source (existing)
# ---------------------------------------------------------------------------
# "file" = json-store is canonical (default)
# "supabase" = Supabase is canonical, file is backup
DATA_SOURCE=file
DUAL_WRITE=false

# Supabase credentials (existing, required when DUAL_WRITE=true)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# LLM platform API keys (CX2)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_ORG_ID=
OPENAI_MODEL=gpt-4o

PERPLEXITY_API_KEY=

SERPAPI_KEY=

# ---------------------------------------------------------------------------
# Cost governance (CX0 / CX2)
# ---------------------------------------------------------------------------
# Maximum USD spend per tenant per day. Audit runs that would exceed fail fast.
BEACON_DAILY_BUDGET_USD_PER_TENANT=5.00
# Global daily budget across ALL tenants (v1 beta safety net).
BEACON_DAILY_BUDGET_GLOBAL_USD=20.00

# ---------------------------------------------------------------------------
# Recommendation engine & surfaces — THE GOLDEN PATH (2026-06-15)
# ---------------------------------------------------------------------------
# Beacon runs ON-DEMAND now (no nightly crons). These flags decide HOW the
# connect → refresh → generate → view loop behaves. See
# docs/GOLDEN_PATH_SETUP.md for the full operator runbook.
#
# Operator cockpit gate. Unlocks /diagnostics/* (refresh-all, run AI reading,
# rebuild recommendation queue). Single-user internal app → set "true".
BEACON_OPERATOR_MODE=true
#
# Recommendation generator. "deterministic" = rule-based only (3 of ~37 action
# types). "openai" = real LLM drafts (needs OPENAI_API_KEY). Default unset ⇒
# deterministic. Operator has authorized LLM → set "openai".
BEACON_LLM_PROVIDER=deterministic
# Enables the LLM draft gateway for diagnostic-only candidates. Default off.
BEACON_LLM_DRAFT_GATEWAY_ENABLED=false
#
# Surface mode. Both default OFF ⇒ the LEGACY surfaces, which GENERATE
# recommendations LIVE on every page load from current data — this is the
# zero-extra-setup golden path (connect + refresh, then just open the page).
#   "true" ⇒ the V2 surfaces, which read only the PRE-PERSISTED queue (fast,
#   but require a "rebuild recommendation queue" step — see promotion below).
BEACON_RECOMMENDATIONS_V2=false
BEACON_TODAY_V2=false
#
# Promotion live-write. Lets the operator "rebuild the recommendation queue"
# (/diagnostics/recommendation-triggers, confirmation phrase "PROMOTE") write
# persisted recommended_edits rows. ONLY needed for the V2 fast surfaces.
# Default unset ⇒ dry-run (computes, writes nothing). Leave off unless V2 is on.
BEACON_PROMOTION_LIVE_WRITE_ENABLED=false

# ---------------------------------------------------------------------------
# Scheduled runs (CX6) — DISABLED 2026-06-15: all crons off, refresh on-demand
# ---------------------------------------------------------------------------
# Set to "true" to enable daily rerun cron. Default: off. (Kept off — Beacon
# refreshes on demand via the operator cockpit, no GitHub Actions minutes.)
BEACON_CRON_ENABLED=false
# Shared secret for the /api/poll/run endpoint (still usable for a manual
# curl-triggered poll; no scheduler calls it now).
CRON_SECRET=

# ---------------------------------------------------------------------------
# Email (CX6 digest + CX7 onboarding)
# ---------------------------------------------------------------------------
BEACON_EMAIL_FROM=hello@beacon.dev
BEACON_EMAIL_API_KEY=
# Provider: "resend" | "postmark"
BEACON_EMAIL_PROVIDER=resend

# ---------------------------------------------------------------------------
# Auth (CX7)
# ---------------------------------------------------------------------------
# Clerk (recommended for v1 beta)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ---------------------------------------------------------------------------
# Billing (CX7)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Observability (CX0 / CX9)
# ---------------------------------------------------------------------------
# Sentry DSN — wired in CX9.
SENTRY_DSN=
# Log level: "debug" | "info" | "warn" | "error"
BEACON_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Smoke testing (CX2.12)
# ---------------------------------------------------------------------------
# Set to "1" to enable the real-API smoke test script.
BEACON_SMOKE_TEST=0

# ---------------------------------------------------------------------------
# Google OAuth (Track 1.4e — GBP; A.3.b1.alpha — GSC scope addition)
# ---------------------------------------------------------------------------
# Required for the Google OAuth flow (GBP review sync + GSC URL Inspection).
# Create OAuth client at https://console.cloud.google.com/ → Credentials.
# Enable both: "My Business Business Information API" + "Search Console API".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Base URL for the OAuth redirect_uri. Defaults to http://localhost:3000.
# Set to the production URL on Vercel (e.g., https://beacon-bice.vercel.app).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OAuth state signing secret (2026-05-16 scope-split). HMAC-SHA256
# signs the `state` parameter that round-trips through Google's
# consent screen. Callback rejects unsigned/tampered/expired state.
# Recommend a 32+ char random string distinct from any other secret.
BEACON_OAUTH_STATE_SECRET=

# GSC property identifier for URL Inspection API (A.3.b1.beta,
# 2026-05-17). Format: `sc-domain:example.com` for domain properties,
# `https://example.com/` for URL-prefix properties. The operator-only
# /diagnostics/indexability page passes this value to gscUrlInspect.
# Customer surfaces never read it. Per-tenant resolution is deferred
# to a future multi-tenant slice; v1 is single-tenant per environment.
BEACON_GSC_SITE_URL=
